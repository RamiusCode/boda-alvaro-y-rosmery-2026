---
// src/components/Invitacion.astro
// El cuerpo completo de la invitación, en un solo lugar.
import Portada from "./Portada.astro";
import NombresFlores from "./NombresFlores.astro";
import Foto1 from "./Foto1.astro";
import Versiculo from "./Versiculo.astro";
import NombresPadres from "./NombresPadres.astro";
import NombresPadrinos from "./NombresPadrinos.astro";
import TituloDia from "./TituloDia.astro";
import BodaCivil from "./BodaCivil.astro";
import SegundoDia from "./SegundoDia.astro";
import RecepcionSocial from "./RecepcionSocial.astro";
import Cronograma from "./Cronograma.astro";
import Cartelera from "./Cartelera.astro";
import CodigoVestimenta from "./CodigoVestimenta.astro";
import SugerenciaRegalo from "./SugerenciaRegalo.astro";
import Restriccion from "./Restriccion.astro";
import Despedida from "./Despedida.astro";
import Pase from "./Pase.astro";
import Dedicatoria from "./Dedicatoria.astro";
import BotonMusica from "./BotonMusica.astro";
import Contador from "./Contador.astro";
import Calendario from "./Calendario.astro";
import Seccion from "./Seccion.astro";

/*
   Cuántos lugares reserva esta invitación. No se toca acá: lo manda la
   página. index.astro no le pasa nada y queda en 0, o sea sin pase;
   pase[cantidad].astro le pasa el número de la URL (/pase1, /pase2...).
*/
export interface Props {
    pases?: number;
}
const { pases = 0 } = Astro.props;
---

<!-- PORTADA (cubre todo hasta que se toca el botón de ingreso) -->
<Portada />

<!-- CONTENIDO DE LA INVITACIÓN -->
<div id="contenido-principal">
    <NombresFlores />
    <Dedicatoria />
    {/* La tarjeta del pase se dibuja siempre, pero en el link sin pase (/)
        arranca escondida: aparece cuando el link trae ?i=codigo y el sistema
        de invitados devuelve el nombre y los pases. */}
    <Pase pases={pases} />
    <Versiculo />
    <NombresPadres />
    {/* Padrinos apagados: los novios todavía no pasaron los nombres. */}
    {/* <NombresPadrinos /> */}
    <Contador />
    <Calendario />
    <Seccion />
    {/* Un solo día: sin boda civil, sin "Primer día" ni segundo día.
        <BodaCivil />
        <TituloDia titulo="Primer día" fecha="..." /> */}
    <RecepcionSocial />
    <Cronograma />
    {/* <SegundoDia /> */}
    {/* Cartelera apagada: eran los grupos de la plantilla, no los de los novios. */}
    {/* <Cartelera /> */}
    <CodigoVestimenta />
    {/* "Solo adultos" apagado: los novios no lo pidieron. */}
    {/* <Restriccion /> */}
    {/* Regalos apagados por ahora: traía el QR de la plantilla, no el de los
        novios. Para volver a mostrarlo, cargar el QR en SugerenciaRegalo.astro
        y volver a poner <SugerenciaRegalo />. */}
    {/* <SugerenciaRegalo /> */}
    {/* Galería apagada: traía las 4 fotos de la pareja anterior. Cuando
        manden más fotos, cargarlas en Foto1.astro y volver a poner <Foto1 />. */}
    {/* <Foto1 /> */}
    <Despedida pases={pases} />
</div>

<!-- El control flotante de la esquina: la nota que pausa y reanuda la melodía -->
<BotonMusica />

<style>
    /*
       Cada sección mide su propio relleno en cqw. Sin un contenedor por
       encima, ese cqw se calcula contra la pantalla entera: en el celular
       da igual (la pantalla ES la columna), pero en la computadora el
       relleno se agrandaba hasta 3 veces y quedaban huecos enormes entre
       secciones. Con esto el cqw se mide contra la columna de 430px, igual
       que en el celular.
    */
    #contenido-principal {
        container-type: inline-size;
    }
</style>
