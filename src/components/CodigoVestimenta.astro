---
// src/components/CodigoVestimenta.astro
// "Código de Vestimenta" en Great Vibes bordó, la etiqueta en Cinzel, la
// pareja vestida de gala (codigo.png) y, debajo, el aviso de los colores
// que no se usan con un círculo por color, tachado con un filete bordó.

// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "Código de Vestimenta";
const etiqueta = "Formal";
const aviso =
    "No usar blanco, reservado para la novia, ni verde pistacho, verde olivo ni turquesa.";
// Los colores que no se usan. Lista vacía, no se dibujan los círculos
const colores = [
    { nombre: "Blanco", color: "#ffffff" },
    { nombre: "Verde pistacho", color: "#93c572" },
    { nombre: "Verde olivo", color: "#708238" },
    { nombre: "Turquesa", color: "#5ec4b8" },
];
// ──────────────────────────────────────────────────────────────
---

<section id="codigo-vestimenta" class="seccion">
    <p class="titulo font-great-vibes">{titulo}</p>
    <p class="etiqueta">{etiqueta}</p>

    <img
        src="/imagenes/codigo.png"
        alt="Pareja vestida de gala: ella con vestido largo, él de traje"
        width="579"
        height="991"
        class="pareja"
    />

    {aviso && <p class="aviso">{aviso}</p>}
    {colores.length > 0 && (
        <ul class="colores">
            {colores.map((c) => (
                <li class="color">
                    <span
                        class="circulo"
                        style={`background-image: linear-gradient(${c.color}, ${c.color})`}
                        aria-hidden="true"
                    />
                    <span class="color-nombre">{c.nombre}</span>
                </li>
            ))}
        </ul>
    )}
</section>

<style>
    .seccion {
        /* Las letras se miden contra el ancho de la sección */
        container-type: inline-size;
        position: relative;
        width: 100%;
        padding: 8cqw 6cqw 10cqw;
        text-align: center;
    }

    .titulo {
        margin: 0;
        color: #7a2335;
        font-size: 13cqw;
        line-height: 1.15;
    }

    .etiqueta {
        margin: 0.6cqw 0 0;
        font-family: "Cinzel", serif;
        font-size: 7cqw;
        letter-spacing: 0.03em;
        color: #6e5a52;
    }

    .pareja {
        display: block;
        width: 30cqw;
        height: auto;
        margin: 6cqw auto 0;
        user-select: none;
        -webkit-user-drag: none;
    }

    .aviso {
        max-width: 82cqw;
        margin: 6cqw auto 0;
        font-family: "Cinzel", serif;
        font-size: 4.6cqw;
        line-height: 1.45;
        color: #6e5a52;
        text-wrap: balance;
    }

    .colores {
        display: flex;
        justify-content: center;
        gap: 3cqw;
        margin: 5cqw 0 0;
        padding: 0;
        list-style: none;
    }

    .color {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 19cqw;
    }

    /* El color va como imagen y no como fondo: el modo oscuro forzado
       respeta las imágenes y no lo da vuelta */
    .circulo {
        position: relative;
        display: block;
        width: 13cqw;
        height: 13cqw;
        border-radius: 50%;
        border: 1px solid #d8c9a0;
        box-shadow:
            0 0 0 1.2cqw #f6f1e8,
            0 0 0 calc(1.2cqw + 1px) #d8c9a0,
            0 4px 10px rgba(0, 0, 0, 0.08);
    }

    /* El filete que lo tacha: "este no" */
    .circulo::after {
        content: "";
        position: absolute;
        left: 50%;
        top: -1.6cqw;
        width: 1.5px;
        height: calc(100% + 3.2cqw);
        margin-left: -0.75px;
        background-image: linear-gradient(#7a2335, #7a2335);
        transform: rotate(45deg);
    }

    .color-nombre {
        margin-top: 3.4cqw;
        font-family: "Cinzel", serif;
        font-size: 3.4cqw;
        line-height: 1.25;
        letter-spacing: 0.04em;
        color: #6e5a52;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const seccion = document.getElementById("codigo-vestimenta");
        if (!seccion) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        const textos = seccion.querySelectorAll(".titulo, .etiqueta");
        const pareja = seccion.querySelector(".pareja");
        const aviso = seccion.querySelector(".aviso");
        const colores = seccion.querySelectorAll(".color");

        gsap.timeline({
            scrollTrigger: {
                trigger: seccion,
                start: "top 80%",
                toggleActions: "play none none reset",
            },
        })
            .fromTo(
                textos,
                { opacity: 0, y: 14 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.9,
                    stagger: 0.18,
                    ease: "power2.out",
                },
            )
            .fromTo(
                pareja,
                { opacity: 0, y: 24 },
                { opacity: 1, y: 0, duration: 1.1, ease: "power3.out" },
                0.5,
            )
            .fromTo(
                aviso,
                { opacity: 0, y: 12 },
                { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" },
                1.1,
            )
            .fromTo(
                colores,
                { opacity: 0, scale: 0.8 },
                {
                    opacity: 1,
                    scale: 1,
                    duration: 0.6,
                    stagger: 0.15,
                    ease: "back.out(2)",
                },
                1.4,
            );
    });
</script>
