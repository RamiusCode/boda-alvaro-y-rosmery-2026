---
// src/components/Dedicatoria.astro
// La cita bíblica: comillas grandes doradas arriba, la frase en Cormorant
// Garamond cursiva vino y la cita (libro y versículo) en dorado debajo.
// Va sobre el papel de la invitación, sin tarjeta.

// ── DATOS EDITABLES ───────────────────────────────────────────
const frase =
    "Así que no son ya más dos, sino una sola carne; por tanto, lo que Dios juntó, no lo separe el hombre.";
const cita = "Mateo 19:6";
// ──────────────────────────────────────────────────────────────
---

<section id="dedicatoria" class="seccion">
    <span class="comillas" aria-hidden="true">“</span>
    <blockquote class="frase">{frase}</blockquote>
    <span class="filete" aria-hidden="true"></span>
    <p class="cita">{cita}</p>
</section>

<style>
    .seccion {
        /* Las letras se miden contra el ancho de la sección */
        container-type: inline-size;
        position: relative;
        width: 100%;
        padding: 10cqw 9cqw 10cqw;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .comillas {
        display: block;
        height: 11cqw;
        font-family: "Cormorant Garamond", serif;
        font-size: 26cqw;
        line-height: 1;
        color: #c9a24e;
    }

    .frase {
        margin: 2cqw 0 0;
        font-family: "Cormorant Garamond", serif;
        font-style: italic;
        font-weight: 400;
        font-size: 6.6cqw;
        line-height: 1.4;
        color: #7a2335;
        text-wrap: balance;
    }

    .filete {
        display: block;
        width: 14cqw;
        height: 1px;
        margin: 5cqw 0 0;
        background-image: linear-gradient(
            90deg,
            rgba(201, 162, 78, 0) 0%,
            #c9a24e 50%,
            rgba(201, 162, 78, 0) 100%
        );
    }

    .cita {
        margin: 3cqw 0 0;
        font-family: "Cormorant Garamond", serif;
        font-style: italic;
        font-size: 6cqw;
        line-height: 1.2;
        color: #b08d46;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const seccion = document.getElementById("dedicatoria");
        if (!seccion) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        gsap.timeline({
            scrollTrigger: {
                trigger: seccion,
                start: "top 80%",
                toggleActions: "play none none reset",
            },
        })
            .fromTo(
                seccion.querySelector(".comillas"),
                { opacity: 0, scale: 0.7 },
                { opacity: 1, scale: 1, duration: 0.8, ease: "back.out(2)" },
            )
            .fromTo(
                seccion.querySelectorAll(".frase, .filete, .cita"),
                { opacity: 0, y: 12 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.9,
                    stagger: 0.2,
                    ease: "power2.out",
                },
                0.3,
            );
    });
</script>
